#!/usr/bin/env sh
set -eu

message_file="$1"
first_line="$(head -n 1 "$message_file")"

if printf "%s" "$first_line" | grep -Eq '^(feat|fix|docs|chore|refactor|test|ops|data|style|perf)(\([a-z0-9._-]+\))?: .{1,120}$'; then
  exit 0
fi

printf "%s\n" "Commit message must use Conventional Commits, for example: feat: add export control"
exit 1
